{
  "name": "frontend-specimen-museum",
  "version": "1.0.0",
  "private": true,
  "description": "AI-friendly frontend specimen catalog and isolated runtime",
  "type": "module",
  "scripts": {
    "docs:check": "node scripts/check-docs.mjs && node scripts/check-history.mjs",
    "generate": "node scripts/generate-catalog.mjs && node scripts/build-specimens.mjs && node scripts/generate-thumbnails.mjs",
    "generate:thumbnails": "node scripts/generate-thumbnails.mjs",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "test:components": "playwright test -c playwright.component.config.ts",
    "test:e2e": "npm run test:e2e:ordinary && npm run test:webgl",
    "test:e2e:ordinary": "playwright test -c playwright.e2e.config.ts --project=e2e-chromium",
    "test:webgl": "playwright test -c playwright.e2e.config.ts --project=webgl-chromium --project=gargantua-webgl-chromium --workers=1",
    "test:visual": "playwright test -c playwright.e2e.config.ts --project=visual-chromium",
    "test:browser": "npm run test:components && playwright test -c playwright.e2e.config.ts --project=e2e-chromium --project=webgl-chromium --project=visual-chromium",
    "check": "npm run docs:check && npm run typecheck && npm run test:unit && node scripts/validate-source.mjs",
    "build": "npm run check && npm run generate && vite build && node scripts/validate-dist.mjs dist",
    "ci:artifact:create": "node scripts/ci/create-artifact.mjs",
    "ci:artifact:verify": "node scripts/ci/verify-artifact.mjs",
    "ci:pages:package": "node scripts/ci/package-pages.mjs",
    "ci:diagnose": "node scripts/ci/download-diagnostics.mjs",
    "ci:smoke": "node scripts/ci/smoke.mjs",
    "dev": "npm run generate && vite",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "jsdom": "^27.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
