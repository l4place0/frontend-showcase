{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontend-showcase.local/learning.schema.json",
  "title": "Specimen learning resource v1",
  "type": "object",
  "required": ["learningVersion", "contentRevision", "itemId", "title", "summary", "difficulty", "durationMinutes", "concepts", "objectives", "prerequisites", "steps", "commonMistakes", "furtherReading", "completion"],
  "properties": {
    "learningVersion": { "const": 1 },
    "contentRevision": { "type": "integer", "minimum": 1 },
    "itemId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "difficulty": { "type": "string", "minLength": 1 },
    "durationMinutes": { "type": "integer", "minimum": 1 },
    "concepts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "steps": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "hint", "title", "body"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "hint": { "type": "string", "minLength": 1 },
          "eyebrow": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "question": { "type": "string" },
          "scene": {
            "type": "object",
            "required": ["viewport", "controls", "screen", "scroll"],
            "properties": {
              "viewport": {
                "type": "object",
                "required": ["minWidth"],
                "properties": { "minWidth": { "type": "integer", "minimum": 0 }, "maxWidth": { "type": "integer", "minimum": 1 } },
                "additionalProperties": true
              },
              "controls": { "type": "object" },
              "screen": { "type": "string", "minLength": 1 },
              "scroll": {
                "type": "object",
                "required": ["x", "y"],
                "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 } },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "anchor", "elbow", "end", "summary", "detail"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "anchor": { "$ref": "#/$defs/point" },
                "elbow": { "$ref": "#/$defs/point" },
                "end": { "$ref": "#/$defs/point" },
                "detailSide": { "type": "string" },
                "summary": { "type": "string", "minLength": 1 },
                "detail": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          },
          "code": {
            "type": "object",
            "required": ["file", "locator", "snippet", "sourceDigest", "sourceScope", "sourceAvailability"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 },
              "snippet": { "type": "string", "minLength": 1 },
              "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              ,"sourceScope": { "type": "string", "minLength": 1 }
              ,"sourceAvailability": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          },
          "experiments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "initial", "controls", "expected", "reset"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "note": { "type": "string" },
                "initial": { "type": "object" },
                "controls": { "type": "object" }
                ,"expected": { "type": "string", "minLength": 1 }
                ,"reset": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          },
          "quiz": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["id", "question", "options", "correct", "explanation"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "question": { "type": "string", "minLength": 1 },
                "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
                "correct": { "type": "integer", "minimum": 0 },
                "explanation": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "commonMistakes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "furtherReading": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "properties": { "label": { "type": "string", "minLength": 1 }, "href": { "type": "string", "minLength": 1 } },
        "additionalProperties": true
      }
    },
    "completion": {
      "type": "object",
      "required": ["criteria"],
      "properties": { "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } },
      "additionalProperties": true
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "number", "minimum": 0, "maximum": 100 }],
      "minItems": 2,
      "maxItems": 2
    }
  },
  "additionalProperties": true
}
